<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>RUSTYCAIN Binary Analyzer</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{--bg:#02020a;--card:rgba(20,20,40,.55);--bd:rgba(130,140,255,.18);--cy:#22d3ee;--pu:#a78bfa;--tx:#e6e8ff;--mu:#7b7fa8;--glow:1;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;min-height:100vh}
#sky{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
main{position:relative;z-index:1;max-width:640px;margin:0 auto;padding:18px 14px 40px}
header{text-align:center;padding:14px 0 6px}
.brand{font-size:clamp(34px,11vw,64px);font-weight:900;letter-spacing:.08em;margin:0;position:relative;display:inline-block;background:linear-gradient(90deg,#f33,#f90,#fe3,#3e5,#2de,#36f,#a4f,#f33);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:rb 6s linear infinite,gl 6s linear infinite}
.brand::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.85) 50%,transparent 60%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;animation:sh 3.5s ease-in-out infinite;mix-blend-mode:overlay}
.glowoff .brand{animation:rb 6s linear infinite;filter:none}
@keyframes rb{to{background-position:300% 0}}
@keyframes sh{from{background-position:150% 0}to{background-position:-150% 0}}
@keyframes gl{0%,100%{filter:drop-shadow(0 0 10px #f33)}16%{filter:drop-shadow(0 0 12px #f90)}33%{filter:drop-shadow(0 0 12px #fe3)}50%{filter:drop-shadow(0 0 12px #3e5)}66%{filter:drop-shadow(0 0 12px #2de)}83%{filter:drop-shadow(0 0 12px #a4f)}}
.sub{letter-spacing:.5em;font-size:13px;color:var(--cy);margin:2px 0 4px;font-weight:600}
.copy{font-size:11px;color:var(--mu)}
.card{background:var(--card);border:1px solid var(--bd);border-radius:26px;padding:16px;margin:16px 0;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 0 calc(24px*var(--glow)) rgba(120,90,255,.12)}
.ch{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.ic{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;font-size:20px;background:linear-gradient(135deg,#8b5cf6,#3b82f6);box-shadow:0 0 calc(14px*var(--glow)) rgba(139,92,246,.6)}
.ch h2{margin:0;font-size:14px;letter-spacing:.12em;color:var(--cy)}
.st{margin-left:auto;font-size:11px;padding:4px 10px;border-radius:99px;border:1px solid var(--bd);color:var(--mu)}
.st.Ready,.st.Completed{color:#4ade80;border-color:#4ade8066}.st.Invalid,.st.Error{color:#f87171;border-color:#f8717166}.st.Processing{color:#fbbf24;border-color:#fbbf2466}
.row{display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.35);border:1px solid var(--bd);border-radius:20px;padding:6px 6px 6px 14px}
.row input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--tx);font:14px ui-monospace,Menlo,monospace;padding:10px 0}
.row input::placeholder{color:#4a4d6e}
.round{width:46px;height:46px;border-radius:50%;border:0;background:#0e2638;color:var(--cy);font-size:20px;cursor:pointer;flex:none}
.meta{font-size:12px;color:var(--mu);margin:10px 4px 0;display:flex;gap:14px;flex-wrap:wrap;min-height:16px}
.btn{min-height:52px;border-radius:99px;border:1px solid var(--bd);background:#0e2638;color:var(--tx);font-size:15px;font-weight:600;padding:0 18px;cursor:pointer;width:100%;margin-top:12px;transition:.2s}
.btn:active{transform:scale(.98)}
.btn.pri{background:linear-gradient(90deg,#0891b2,#7c3aed);border:0;box-shadow:0 0 calc(18px*var(--glow)) rgba(124,58,237,.5);letter-spacing:.1em}
.btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.btn.sm{width:auto;min-height:44px;margin:6px 6px 0 0;font-size:13px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.two .btn{margin-top:0}
h3.sec{font-size:12px;letter-spacing:.3em;color:var(--mu);text-align:center;margin:26px 0 -4px}
.bar{height:10px;border-radius:99px;background:#0b0c1e;overflow:hidden;margin:10px 0}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cy),var(--pu));transition:width .2s}
.log{background:#05050f;border:1px solid var(--bd);border-radius:16px;padding:10px;font:11.5px/1.5 ui-monospace,Menlo,monospace;color:#9fb4ff;height:170px;overflow:auto;white-space:pre-wrap;word-break:break-all}
.stats{display:flex;justify-content:space-between;font-size:12px;color:var(--mu)}
.modal{position:fixed;inset:0;z-index:20;background:rgba(0,0,6,.7);display:none;align-items:flex-end;justify-content:center;padding:0}
.modal.on{display:flex}
.sheet{background:#0b0b1c;border:1px solid var(--bd);border-radius:28px 28px 0 0;width:100%;max-width:560px;max-height:85vh;overflow:auto;padding:20px 18px calc(24px + env(safe-area-inset-bottom,0px))}
.sheet h2{margin:0 0 10px;color:var(--cy);font-size:16px;letter-spacing:.1em}
.opt{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #ffffff10;font-size:14px}
